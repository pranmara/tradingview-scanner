# ---------- Public HTTPS for the TradingView webhook (docker-compose.prod.yml / Caddy) ----------
# A DNS name pointing at this VPS. Free option: create <name>.duckdns.org at https://www.duckdns.org
WEBHOOK_DOMAIN=
ACME_EMAIL=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Comma-separated Telegram user IDs allowed to run /scan. Empty = nobody.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_SCAN_COOLDOWN_SECONDS=10

# ---------- TradingView webhook ingestion ----------
# Must match the secret_key sent from Pine Script alerts.
TV_WEBHOOK_SECRET=change-me-long-random-string
# Optional: HMAC-SHA256 key for relays that can set X-Signature (TradingView itself cannot).
TV_WEBHOOK_HMAC_KEY=
# Reject alert POSTs not originating from TradingView's published IPs.
TV_WEBHOOK_ENFORCE_IP_ALLOWLIST=true
# Set true only when behind a reverse proxy that sets X-Forwarded-For.
TV_WEBHOOK_TRUST_PROXY=false
TV_WEBHOOK_MAX_SKEW_SECONDS=300
TV_ALERT_TTL_SECONDS=21600

# ---------- TradingView chart feed (UNOFFICIAL websocket; on by default, anonymous) ----------
# Primary candle source for crypto AND stocks — the same bars your chart shows, no key needed.
# Add your `sessionid` (+ `sessionid_sign`) cookies from a logged-in tradingview.com browser to unlock your plan's data
# and account-only indicators (/indicators in Telegram). Rotate the cookie if leaked; never commit it.
# Username/password signin usually fails on captcha/2FA; the cookie is the reliable path.
TV_FEED_ENABLED=true
TV_SESSION_ID=
TV_SESSION_ID_SIGN=
TV_USERNAME=
TV_PASSWORD=
TV_SESSION_TIMEOUT_SECONDS=25
TV_STUDIES_PATH=config/tv_studies.json

# ---------- TradingView MCP (optional; leave empty to use REST fallbacks only) ----------
# Inside compose with the "mcp" profile: http://tradingview-mcp:8000/mcp
TV_MCP_URL=
TV_MCP_OHLCV_TOOL=get_ohlcv
TV_MCP_SNAPSHOT_TOOL=get_technical_analysis
TV_MCP_TIMEOUT_SECONDS=20
# pip package + console entrypoint installed into the MCP container image.
TV_MCP_PACKAGE=tradingview-mcp-server
TV_MCP_ENTRYPOINT=tradingview-mcp-server

# ---------- TradingView scanner REST fallback ----------
TV_SCANNER_STOCK_MARKET=america
TV_SCANNER_DEFAULT_STOCK_EXCHANGES=NASDAQ,NYSE,AMEX
TV_SCANNER_DEFAULT_CRYPTO_EXCHANGE=BINANCE

# ---------- Stock candles (optional) ----------
# Yahoo is unauthenticated and rate-limits aggressively. A free Twelve Data key (800 credits/day)
# is used first for stocks/ETFs when set. Without either, stock scans degrade to snapshot-only.
TWELVEDATA_API_KEY=

# ---------- Nansen (zero base weight; a credit of up to +10 applied only when activated and data returns) ----------
# off      = never queried, no credit
# advisory = credit + "cautions" in the report; never blocks a signal   (default)
# strict   = credit + hard vetoes (negative SM netflow / large exchange inflow block longs)
NANSEN_MODE=advisory
# Leave empty to run without on-chain data (base matrix still scores out of 100).
NANSEN_API_KEY=
NANSEN_BASE_URL=https://api.nansen.ai/api/v1
NANSEN_CACHE_TTL_SECONDS=300
NANSEN_TOKEN_MAP_PATH=config/nansen_token_map.json
NANSEN_SM_NETFLOW_FULL_SCORE_USD=1000000
NANSEN_EXCHANGE_INFLOW_VETO_USD=5000000

# ---------- Storage ----------
REDIS_URL=redis://redis:6379/0

# ---------- Execution (both flags must be flipped before anything is sent) ----------
EXECUTION_ENABLED=false
DRY_RUN=true
EXECUTION_WEBHOOK_URL=
EXECUTION_HMAC_KEY=

# ---------- Decision engine ----------
MIN_SIGNAL_SCORE=80
WATCH_SCORE=60
MIN_RRR=2.5
ATR_MULTIPLIER=1.5
MAX_STOP_DISTANCE_PCT=8
CANDLE_LIMIT=300
BENCHMARK_SYMBOL=SPY

# ---------- Regime filters (best-practice gates; each adds a veto, never points) ----------
HTF_BIAS_FILTER=true          # no longs when the next-higher TF EMA ribbon is bearish (and vice versa)
MIN_ADX=20                    # primary-TF ADX below this = chop, no trend-following signal
RSI_OVEREXTENDED=75           # no BUY above this RSI / no SELL below (100 - this)
SESSION_FILTER=true           # intraday scans outside London/NY kill zones (UTC 07-10, 12-15) get a caution

# ---------- Risk management ----------
ACCOUNT_EQUITY=0              # > 0 enables position sizing in reports/execution payloads
RISK_PER_TRADE_PCT=1.0

# ---------- Custom indicators & journal ----------
CUSTOM_INDICATORS_PATH=config/custom_indicators.json
SIGNAL_JOURNAL_PATH=data/signals.jsonl

# ---------- Bybit (crypto candle fallback) ----------
# Used only when Binance has no such symbol. Spot is tried first, then the linear perpetual, since newer
# tokens often trade as a perp months before they get a spot pair. Public market data, no API key needed.
BYBIT_ENABLED=true
TV_SCANNER_CRYPTO_EXCHANGE_FALLBACKS=BYBIT   # TradingView ratings for tokens Binance does not list
BYBIT_BASE_URL=https://api.bybit.com

# ---------- TypeSafe (Jev) ----------
# Optional, four independent features, each with its own on/off flag:
#  1. /indicators add reads the script's own metadata (and probes a few bars) to pick bucket / signal plot /
#     bull-bear thresholds / points instead of defaulting to plot_0 and 0/0. One request per add.
#  2. /scan accepts natural language, and plain messages are routed to the right command. One request per
#     message, and only when the strict `/scan TICKER [TF]` form does not parse.
#  3. A bare ticker with no exchange prefix and no known quote asset is resolved to crypto or stock instead
#     of silently defaulting to stock. One cached request per ticker, on the scan path only.
#  4. A Pine alert whose indicator name has drifted from its custom_indicators.json key is matched back to
#     that rule instead of silently scoring on the defaults. One cached request per name, per rule set.
#     Unmatched names are reported in the scan either way, whether or not a key is set.
# None of them run inside a scan's scoring or in the backtester. An outage or a low-confidence answer
# always falls back to the existing behaviour.
TYPESAFE_API_KEY=
TYPESAFE_AUTOCONFIG=true         # auto-configure /indicators add from the script's own metadata
TYPESAFE_NATURAL_LANGUAGE=true   # accept "is btc worth a long on the 4h", and plain messages with no slash
TYPESAFE_SYMBOL_RESOLUTION=true  # place bare tickers KNOWN_CRYPTO_BASES has not caught up with
TYPESAFE_INDICATOR_MATCHING=true # match drifted Pine alert names back to their configured rule
# Leave TYPESAFE_MODEL blank to use the SDK/account default (Jev). Keep the comment on its own line:
# Compose's env_file parser treats a trailing comment as the value when the value itself is empty.
TYPESAFE_MODEL=
TYPESAFE_MIN_CONFIDENCE=0.55  # below this, keep the manual defaults and say which answer was shaky
TYPESAFE_TIMEOUT_SECONDS=10
TYPESAFE_PROBE_SYMBOL=BINANCE:BTCUSDT   # instrument used once, at add time, to see what the plots actually print
TYPESAFE_PROBE_TIMEFRAME=4h
TYPESAFE_PROBE_BARS=120
TYPESAFE_SYMBOL_MIN_CONFIDENCE=0.7      # stricter than the others: this decides which market gets loaded
TYPESAFE_SYMBOL_CACHE_TTL_SECONDS=2592000   # 30d; cached in Redis when configured, in memory otherwise
TYPESAFE_INDICATOR_MIN_CONFIDENCE=0.7   # a wrong match scores an alert into the wrong bucket

# ---------- Forward journal (out-of-sample test of the score) ----------
# Scans a fixed watchlist 5 minutes after every candle closes and records EVERY report to SIGNAL_JOURNAL_PATH,
# then posts a weekly digest to Telegram answering one question: does the score rank outcomes on bars that had not
# happened yet? Runs on its own orchestrator: public data only (never your TradingView session), execution
# disabled, Nansen off. It cannot place an order. /journal shows the digest on demand.
JOURNAL_ENABLED=true
JOURNAL_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,LTCUSDT,NEARUSDT,ATOMUSDT
JOURNAL_TIMEFRAME=4h
# Must divide 24: slots are anchored to 00:00 UTC
JOURNAL_INTERVAL_HOURS=4
JOURNAL_OFFSET_MINUTES=5
# 0 = Monday
JOURNAL_DIGEST_WEEKDAY=0
JOURNAL_DIGEST_HOUR_UTC=8

# ---------- Backtest defaults ----------
BACKTEST_FEE_BPS=10
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_TIME_STOP_BARS=40

LOG_LEVEL=INFO
